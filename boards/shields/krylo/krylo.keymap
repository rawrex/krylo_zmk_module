#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp Q      &kp W      &kp F       &kp P         &kp B    /* split */  &kp J       &kp L        &kp U       &kp Y      &kp SQT
                &kp A      &kp R      &kp S       &kp T         &kp G    /* split */  &kp M       &kp N        &kp E       &kp I      &kp O
                &kp Z      &kp X      &kp C       &kp D                  /* split */              &kp H        &kp COMMA   &kp DOT    &kp FSLH
                                                  &kp SPACE     &kp TAB  /* split */  &kp RET     &kp BSPC
            >;
        };
    };
};
