// V/K bottom-row combos and ESC/DEL thumb combos.
// Always active.

#include "macros.h"

/ {
    combos {
        compatible = "zmk,combos";

        // V = C(22) + D(23)
        combo_v {
            layers = <U_BASE>;
            key-positions = <22 23>;
            bindings = <&kp V>;
            timeout-ms = <50>;
        };

        // K = H(24) + ,(25)
        combo_k {
            layers = <U_BASE>;
            key-positions = <24 25>;
            bindings = <&kp K>;
            timeout-ms = <50>;
        };

        // ESC = home row (14 + 15)
        combo_esc {
            layers = <U_BASE>;
            key-positions = <14 15>;
            bindings = <&kp ESC>;
            timeout-ms = <85>;
            require-prior-idle-ms = <120>;
        };

        // DEL = thumbs (29 + 30)
        combo_del {
            layers = <U_BASE>;
            key-positions = <29 30>;
            bindings = <&kp DEL>;
            timeout-ms = <85>;
            require-prior-idle-ms = <120>;
        };
    };
};
