// V/K bottom-row combos and ESC/DEL thumb combos.
// Always active.

#include "macros.h"

/ {
    combos {
        compatible = "zmk,combos";

        // V = C(22) + D(23)
        combo_v {
            layers = <U_BASE>;
            key-positions = <22 23>;
            bindings = <&kp V>;
            timeout-ms = <50>;
        };

        // K = H(24) + ,(25)
        combo_k {
            layers = <U_BASE>;
            key-positions = <24 25>;
            bindings = <&kp K>;
            timeout-ms = <50>;
        };

        // ESC = inner thumbs (29 + 30)
        combo_esc {
            key-positions = <29 30>;
            bindings = <&kp ESC>;
            timeout-ms = <200>;
        };

        // DEL = outer thumbs (28 + 31)
        combo_del {
            key-positions = <28 31>;
            bindings = <&kp DEL>;
            timeout-ms = <200>;
        };
    };
};
