#include "macros.h"

&soft_off {
    hold-time-ms = <2500>;
};

/ {
keymap {
compatible = "zmk,keymap";

base_layer {
    display-name = "Base";
    bindings = <
        &u_lt U_FUN Q        &kp W           &kp F            &kp P             &kp B           &kp J           &kp L              &kp U               &kp Y            &u_lt U_MEDIA SQT
        &u_mt LGUI A         &u_mt LALT R    &u_mt LCTRL S    &u_mt LSHFT T     &kp G           &kp M           &u_mt LSHFT N      &u_mt LCTRL E       &u_mt LALT I     &u_mt LGUI O
        &kp Z                &u_mt RALT X    &kp C            &kp D                                             &kp H              &kp COMMA           &u_mt RALT DOT   &kp SLASH
                                                              &u_lt U_NAV SPACE &u_lt U_NUM TAB &u_lt U_NUM RET &u_lt U_SYM BSPC
    >;
};

sym_layer {
    display-name = "Sym";
    bindings = <
        &kp BSLH             &kp LT          &kp MINUS        &kp GT            &kp RU_SHCH     &none           &to_base_alt_shift &to_extra_alt_shift &none            &u_bootloader
        &kp EXCL             &kp LPAR        &kp PRCNT        &kp RPAR          &kp V           &none           &kp LSHFT          &kp LCTRL           &kp LALT         &kp LGUI
        &kp HASH             &kp LBRC        &kp PLUS         &kp RBRC                                          &to U_SYM          &u_caps_word        &kp RALT         &none
                                                              &kp EQUAL         &kp UNDER       &soft_off       &none
    >;
};

num_layer {
    display-name = "Num";
    bindings = <
        &none                &kp AMPS        &kp TILDE        &kp GRAVE         &batt           &batt           &kp N7             &kp N8              &kp N9           &u_bootloader
        &kp CARET            &kp PIPE        &kp ASTRK        &kp DLLR          &none           &kp RU_SH       &kp N4             &kp N5              &kp N6           &kp LGUI
        &kp QMARK            &kp LBKT        &kp AT           &kp RBKT                                          &kp N1             &kp N2              &kp N3           &kp N0
                                                              &kp SEMI          &kp COLON       &trans          &trans
    >;
};

nav_layer {
    display-name = "Nav";
    bindings = <
        &u_bootloader        &u_to_U_TAP     &u_to_U_EXTRA    &u_to_U_BASE      &none           U_RDO           U_PST              U_CPY               U_CUT            U_UND
        &kp LGUI             &kp LALT        &kp LCTRL        &kp LSHFT         &none           &kp K           &kp LEFT           &kp DOWN            &kp UP           &kp RIGHT
        &none                &kp RALT        &u_to_U_NUM      &u_to_U_NAV                                       &kp HOME           &kp PG_DN           &kp PG_UP        &kp END
                                                              &none             &soft_off       &kp RET         &kp ESC
    >;
};

media_layer {
    display-name = "Media";
    bindings = <
        &u_bootloader        &u_to_U_TAP     &u_to_U_EXTRA    &u_to_U_BASE      &none           &none           &none              &none               &none            &none
        &kp LGUI             &kp LALT        &kp LCTRL        &kp LSHFT         &none           &kp C_STOP      &kp C_PREV         &kp C_VOL_DN        &kp C_VOL_UP     &kp C_NEXT
        &none                &kp RALT        &u_to_U_FUN      &u_to_U_MEDIA                                     &u_bt_sel_0        &u_bt_sel_1         &u_bt_sel_2      &u_bt_sel_3
                                                              &none             &none           &kp C_MUTE      &kp C_PP
    >;
};

fun_layer {
    display-name = "Fun";
    bindings = <
        &none                &kp F7          &kp F8           &kp F9            &kp PSCRN       &none           &u_to_U_BASE       &u_to_U_EXTRA       &u_to_U_TAP      &u_bootloader
        &kp F11              &kp F4          &kp F5           &kp F6            &kp F12         &none           &kp LSHFT          &kp LCTRL           &kp LALT         &kp LGUI
        &kp F10              &kp F1          &kp F2           &kp F3                                            &u_to_U_FUN        &u_to_U_MEDIA       &kp RALT         &none
                                                              &kp SPACE         &kp TAB         &kp RET         &kp ESC
    >;
};

tap_layer {
    display-name = "Tap";
    bindings = <
        &kp Q                &kp W           &kp E            &kp R             &kp T           &kp Y           &kp U              &kp I               &kp O            &kp P
        &kp A                &kp S           &kp D            &kp F             &kp G           &kp H           &kp J              &kp K               &kp L            &kp SQT
        &kp Z                &kp X           &kp C            &kp V                                             &kp M              &kp COMMA           &kp DOT          &kp SLASH
                                                              &kp SPACE         &kp TAB         &kp RET         &kp BSPC
    >;
};

extra_layer {
    display-name = "Cyrillic";
    bindings = <
        &kp RU_TS            &kp RU_K        &kp RU_L         &kp RU_B          &kp RU_J        &kp RU_YU       &kp RU_Y           &kp RU_YA           &kp RU_E         &kp RU_F
        &u_mt LGUI RU_Z      &u_mt LALT RU_V &u_mt LCTRL RU_N &u_mt LSHFT RU_T  &kp RU_D        &kp RU_I        &u_mt LSHFT RU_A   &u_mt LCTRL RU_O    &u_mt LALT RU_YE &u_mt LGUI RU_S
        &kp RU_KH            &u_mt RALT RU_P &kp RU_R         &kp RU_M                                          &kp RU_U           &kp COMMA           &u_mt RALT DOT   &kp SLASH
                                                              &u_lt U_NAV SPACE &u_lt U_NUM TAB &u_lt U_NUM RET &u_lt U_SYM BSPC
    >;
};
};
};
